LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
KUGELAUDIO_API_KEY=

# Input noise filter: clarity (default) or ai_coustics
# NOISE_FILTER=clarity
# Optional: clean 2-8 s WAV of your voice so Clarity keeps only you
# CLARITY_SPEAKER_WAV=assets/my_voice.wav

# Robot backend: fake (default, Rerun 3D view) or real (SO-100 on USB)
# ROBOT=real

# Dream-1 vision planner (do_task tool): the API key lives in ~/.dreamlabs/credentials,
# see https://platform.dreamlabs.ai/api-documentation/
# DREAM_CHECKPOINT=dreamlabs/dream-1-beta
# WRIST_CAMERA_INDEX=0
# WRIST_CAMERA_ROTATE=0   # 90, 180 or 270 if the wrist camera is mounted turned

# Real arm (ROBOT=real): serial port and LeRobot calibration id
# ROBOT_PORT=/dev/tty.usbmodemXXXX
# ROBOT_ID=my_follower
